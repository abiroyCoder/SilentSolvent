# Copy to .env.preprod locally; never commit the copied file.
# Supply a wallet mnemonic only in a secret manager or process environment.
MIDNIGHT_PREPROD_MNEMONIC="replace-with-a-funded-24-word-preprod-mnemonic"
MIDNIGHT_PROOF_SERVER="https://replace-with-your-preprod-proof-server"
ATTESTATION_API_URL="https://replace-with-your-attestation-service"
SILENTSOLVENT_ADMIN_SECRET_HEX="replace-with-32-byte-admin-secret-hex"
