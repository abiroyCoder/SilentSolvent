{
  "name": "silentsolvent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-runtime.cjs",
    "compile": "compact compile contracts/silentsolvent.compact contracts/managed/silentsolvent && node scripts/patch-runtime.cjs",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:local": "cross-env MIDNIGHT_NETWORK=local npm run test",
    "test:preview": "cross-env MIDNIGHT_NETWORK=preview npm run test",
    "test:preprod": "cross-env MIDNIGHT_NETWORK=preprod RUN_PREPROD_E2E=1 npm run test", 
    "check:artifacts": "node scripts/check-artifact-drift.mjs",
    "deploy:preprod": "node --experimental-strip-types scripts/deploy-preprod.ts",
    "e2e:preprod": "node --experimental-strip-types scripts/preprod-e2e.ts",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "copy:managed": "node -e \"const fs = require('fs'); fs.cpSync('contracts/managed/silentsolvent/contract', 'frontend/src/managed/contract', {recursive: true}); fs.cpSync('contracts/managed/silentsolvent', 'frontend/public/managed', {recursive: true})\"",
    "build": "npm run build -w silentsolvent-frontend"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.0.0",
    "@scure/bip39": "2.4.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3",
    "rxjs": "7.8.2",
    "ws": "8.21.3"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/ws": "8.18.1",
    "cross-env": "10.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
